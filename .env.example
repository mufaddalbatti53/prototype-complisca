# Core app settings
PROJECT_NAME=C.O.M.P.L.I.S.C.A.N.
VERSION=1.0.0
API_V1_STR=/api/v1

# AI workflow
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend runtime
DATABASE_URL=postgresql://postgres:postgres@db.<project-ref>.supabase.co:5432/postgres
# DATABASE_URL=sqlite:///./backend/storage/compliscan.db

# Supabase configuration (Postgres + auth + storage)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=compliance-evidence

# Optional API access gate. If enabled, set API_KEY and the matching VITE_API_KEY.
API_AUTH_REQUIRED=false
API_KEY=
MAX_UPLOAD_SIZE_MB=10

# Storage / file uploads
STORAGE_DIR=./backend/storage
UPLOAD_DIR=./backend/storage/uploads
PROCESSED_DIR=./backend/storage/processed
REPORT_DIR=./backend/storage/reports
SAMPLES_DIR=./backend/storage/samples

# Deployment URLs
FRONTEND_URL=https://prototype-complisca.vercel.app
BACKEND_URL=https://prototype-complisca.onrender.com
VITE_BACKEND_URL=https://prototype-complisca.onrender.com
VITE_API_KEY=
